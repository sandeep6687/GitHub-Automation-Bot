# Backend API Base URL override.
#
# Leave EMPTY in normal use:
#   - Local dev:   Vite proxy (vite.config.ts) forwards /api/* → http://localhost:5000
#   - Production:  Vercel rewrite (vercel.json) forwards /api/* → Render backend
#
# Only set this if you want to point a local frontend at a staging backend directly.
# Example: VITE_API_URL=https://staging-backend.onrender.com
VITE_API_URL=
