# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=Host=localhost;Port=5432;Database=github_bot;Username=postgres;Password=postgres

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# Slack App Credentials (Optional for local development)
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback

# JWT Settings
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_chars!
JWT_ISSUER=GitHubBot
JWT_AUDIENCE=GitHubBotClient
JWT_EXPIRY_MINUTES=1440

# At-Rest Token Encryption (AES-256-GCM - 32-byte Base64 encoded key)
ENCRYPTION_KEY=your_base64_encoded_32_byte_aes_key_here

# Background Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LOCK_TIMEOUT_MINUTES=5
WORKER_MAX_PARALLELISM=5
