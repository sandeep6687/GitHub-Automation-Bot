# ==============================================================================
# GitHub Automation Bot - Environment Configuration Template
# ==============================================================================

# Database Connection (Supports standard key-value string or postgres:// URI from Neon / Render)
# Examples:
#   ConnectionStrings__Database=Host=ep-xyz.neon.tech;Port=5432;Database=neondb;Username=user;Password=pass;SSL Mode=Require
#   DATABASE_URL=postgres://user:pass@ep-xyz.neon.tech/neondb?sslmode=require
ConnectionStrings__Database=Host=localhost;Port=5432;Database=github_bot;Username=postgres;Password=postgres
# Database__ApplyMigrationsOnStartup=true

# GitHub OAuth App Credentials (from https://github.com/settings/developers)
GitHub__ClientId=your_github_client_id_placeholder
GitHub__ClientSecret=your_github_client_secret_placeholder
# Production OAuth Callback URL (e.g., https://your-backend.onrender.com/api/auth/callback)
GitHub__RedirectUri=http://localhost:5000/api/auth/callback

# Public Webhook Ingestion URL (must be public HTTPS reachable by GitHub, e.g. https://your-backend.onrender.com/api/webhooks/github)
Webhooks__PublicUrl=http://localhost:5000/api/webhooks/github

# Slack Incoming Webhook (Optional server-side secret, e.g., https://hooks.slack.com/services/T00/B00/XXXX)
Slack__WebhookUrl=

# At-Rest Token Encryption (32-byte Base64 key for AES-256-GCM token storage)
Encryption__Key=your_32_byte_base64_encryption_key_placeholder

# Deployed Frontend URL (used for CORS and OAuth redirect destination)
# Example: https://your-app.vercel.app or https://your-frontend.onrender.com
FrontendUrl=http://localhost:5173

# Authentication & Session Settings
Authentication__CookieName=gh_bot_session
Authentication__SessionExpirationMinutes=1440

# Background Worker Settings
Worker__PollIntervalSeconds=2
Worker__LockTimeoutMinutes=5
Worker__MaxDegreeOfParallelism=5
