# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=Host=localhost;Port=5432;Database=github_bot;Username=postgres;Password=postgres

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Slack App Credentials
SLACK_CLIENT_ID=your_slack_client_id_placeholder
SLACK_CLIENT_SECRET=your_slack_client_secret_placeholder
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback

# At-Rest Token Encryption (AES-256-GCM - 32-byte Base64 encoded key)
ENCRYPTION_KEY=your_32_byte_base64_encryption_key_placeholder

# Authentication & Session Settings
AUTHENTICATION_COOKIE_NAME=gh_bot_session
AUTHENTICATION_SESSION_EXPIRATION_MINUTES=1440

# Background Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LOCK_TIMEOUT_MINUTES=5
WORKER_MAX_PARALLELISM=5
